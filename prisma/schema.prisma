// LegalSuite Core - Prisma Schema
// Boutique & Solo Legal Practice Management System
// Architect: Benedict Garcia
// Version: 0.1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS - Type Safety for Domain Logic
// ============================================

enum UserRole {
  LEAD_ATTORNEY
  ASSOCIATE
  STAFF
}

enum MatterStatus {
  ACTIVE
  FOR_PLEADING
  UNDER_SUBMISSION
  PROMULGATED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  FOR_ATTORNEY_REVIEW
  COMPLETED_FILED
}

enum UrgencyLevel {
  CRITICAL
  UPCOMING
  ON_SCHEDULE
}

enum DocumentCategory {
  PLEADINGS_MOTIONS
  COURT_ORDERS
  EVIDENCE_ANNEXES
  CORRESPONDENCE_BILLING
}

enum AuditAction {
  VIEW
  DOWNLOAD
  UPLOAD
  DELETE
  UPDATE
  CREATE
  LOGIN
  LOGOUT
}

enum BillingType {
  APPEARANCE_FEE
  DRAFTING_FEE
  ACCEPTANCE_RETAINER
  COURT_FILING_FEE
  NOTARIAL_FEE
  TRANSPORT_FEE
  SHERIFF_FEE
  OTHER_DISBURSEMENT
}

enum PaymentStatus {
  UNBILLED
  BILLED
  PARTIALLY_PAID
  PAID
  WAIVED
}

// ============================================
// MODULE 1: Authentication & User Administration
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  phone         String?
  barLicenseNo  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  invitedBy     User?     @relation("UserInvitations", fields: [invitedById], references: [id])
  invitedById   String?
  invitations   User[]    @relation("UserInvitations")

  assignedMatters MatterMember[]
  createdMatters  Matter[]       @relation("MatterCreator")
  tasks           Task[]         @relation("TaskAssignee")
  assignedTasks   Task[]         @relation("TaskAssigner")
  billingEntries  BillingEntry[]
  auditLogs       AuditLog[]
  sessions        Session[]
  notifications   Notification[]

  @@index([email])
  @@index([role, isActive])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  role        UserRole
  token       String   @unique
  invitedBy   String
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([token])
  @@index([email, isActive])
}

// ============================================
// MODULE 2: Matter & Docket Hub
// ============================================

model Matter {
  id              String       @id @default(cuid())
  caseTitle       String
  docketNumber    String?
  courtBranch     String
  presidingJudge  String?
  opposingCounsel String?
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?

  status          MatterStatus @default(ACTIVE)
  priority        String       @default("NORMAL")
  caseType        String?

  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  archivedAt      DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy       User         @relation("MatterCreator", fields: [createdById], references: [id])
  createdById     String

  members         MatterMember[]
  documents       Document[]
  tasks           Task[]
  deadlines       Deadline[]
  hearings        Hearing[]
  billingEntries  BillingEntry[]
  invoices        Invoice[]

  @@index([status])
  @@index([docketNumber])
  @@index([createdById, status])
  @@index([clientName])
}

model MatterMember {
  id        String   @id @default(cuid())
  matterId  String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
  @@index([matterId])
  @@index([userId])
}

// ============================================
// MODULE 3: Court Calendaring & Deadlines
// ============================================

model Deadline {
  id              String       @id @default(cuid())
  matterId        String
  title           String
  description     String?

  triggerDate     DateTime
  dueDate         DateTime
  periodDays      Int

  urgencyLevel    UrgencyLevel @default(ON_SCHEDULE)
  isCompleted     Boolean      @default(false)
  completedAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  matter          Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@index([matterId])
  @@index([dueDate])
  @@index([urgencyLevel, isCompleted])
  @@index([dueDate, isCompleted])
}

model Hearing {
  id            String   @id @default(cuid())
  matterId      String
  title         String
  description   String?

  scheduledAt   DateTime
  location      String?
  hearingType   String?

  isCompleted   Boolean  @default(false)
  notes         String?  @db.Text
  outcome       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matter        Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([scheduledAt])
}

// ============================================
// MODULE 4: Digital Case Binder (Document Vault)
// ============================================

model Document {
  id            String           @id @default(cuid())
  matterId      String
  title         String
  description   String?

  category      DocumentCategory
  fileName      String
  fileSize      Int
  mimeType      String
  storageKey    String           @unique
  storageUrl    String?

  uploadedBy    String
  version       Int              @default(1)
  parentDocId   String?

  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  deletedBy     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  matter        Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([category])
  @@index([uploadedBy])
  @@index([matterId, category])
}

// ============================================
// MODULE 5: Collaborative Workflow & Tasks
// ============================================

model Task {
  id             String       @id @default(cuid())
  matterId       String
  deadlineId     String?

  title          String
  description    String?      @db.Text

  status         TaskStatus   @default(TODO)
  priority       String       @default("MEDIUM")

  assigneeId     String?
  assignedById   String

  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  estimatedHours Decimal?     @db.Decimal(5, 2)
  actualHours    Decimal?     @db.Decimal(5, 2)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  matter         Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  deadline       Deadline?    @relation(fields: [deadlineId], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedBy     User         @relation("TaskAssigner", fields: [assignedById], references: [id])

  @@index([matterId])
  @@index([assigneeId, status])
  @@index([status])
  @@index([dueDate, status])
}

// ============================================
// MODULE 6: Fee Accounting & Billing
// ============================================

model BillingEntry {
  id            String       @id @default(cuid())
  matterId      String
  userId        String?

  entryType     String       @default("TIME")
  billingType   BillingType

  title         String
  description   String?      @db.Text

  datePerformed DateTime
  hours         Decimal?     @db.Decimal(5, 2)
  hourlyRate    Decimal?     @db.Decimal(10, 2)

  amount        Decimal      @db.Decimal(10, 2)
  isBillable    Boolean      @default(true)
  paymentStatus PaymentStatus @default(UNBILLED)

  receiptNo     String?
  receiptUrl    String?

  notes         String?      @db.Text

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  matter        Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id])
  invoiceItems  InvoiceItem[]

  @@index([matterId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([datePerformed])
  @@index([matterId, paymentStatus])
}

model Invoice {
  id            String   @id @default(cuid())
  matterId      String
  invoiceNo     String   @unique
  clientName    String
  clientEmail   String?
  clientAddress String?  @db.Text

  issueDate     DateTime @default(now())
  dueDate       DateTime
  totalAmount   Decimal  @db.Decimal(10, 2)
  amountPaid    Decimal  @db.Decimal(10, 2) @default(0)
  balance       Decimal  @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(UNBILLED)
  notes         String?  @db.Text

  pdfStorageKey String?
  pdfUrl        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matter        Matter   @relation(fields: [matterId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@index([matterId])
  @@index([invoiceNo])
  @@index([paymentStatus])
  @@index([issueDate])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  billingEntryId String

  description    String   @db.Text
  quantity       Decimal  @db.Decimal(5, 2) @default(1)
  unitPrice      Decimal  @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(10, 2)

  createdAt      DateTime @default(now())

  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingEntry   BillingEntry @relation(fields: [billingEntryId], references: [id])

  @@index([invoiceId])
  @@index([billingEntryId])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Decimal  @db.Decimal(10, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String?
  referenceNo   String?
  notes         String?

  createdAt     DateTime @default(now())

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentDate])
}

// ============================================
// Audit & Compliance (Immutable Logs)
// ============================================

model AuditLog {
  id            String      @id @default(cuid())

  userId        String?
  userIpAddress String?
  userAgent     String?

  action        AuditAction
  entityType    String
  entityId      String
  entityTitle   String?

  metadata      Json?

  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ============================================
// System Configuration & Settings
// ============================================

model FirmSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String   @db.Text
  description   String?
  updatedAt     DateTime @updatedAt

  @@index([key])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  message       String   @db.Text
  type          String   @default("INFO")
  link          String?
  isRead        Boolean  @default(false)

  createdAt     DateTime @default(now())
  readAt        DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
