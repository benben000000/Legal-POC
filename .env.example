# Environment Variables for Legal Demo (Philippine Practice Management)
# Copy to .env and fill in actual values for production deployment

# Database (Neon PostgreSQL in AWS ap-southeast-1 Singapore)
DATABASE_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="change-this-to-a-random-64-char-string-in-production"

# Application URL & Branding
NEXT_PUBLIC_APP_URL="https://legal-demo-azure.vercel.app"
NEXT_PUBLIC_APP_NAME="Legal Demo"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NODE_ENV="production"

# Upstash Redis (Optional - for distributed edge rate limiting)
# If omitted, application uses high-performance in-memory sliding window rate limiting
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# Sentry / Error Tracking (Optional)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# File Storage (Cloudflare R2 / AWS S3)
# R2_ENDPOINT=""
# R2_ACCESS_KEY=""
# R2_SECRET_KEY=""
# R2_BUCKET=""
